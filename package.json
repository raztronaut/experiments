  "scripts": {
    "dev": "next dev",
    "generate:all": "node scripts/generate-all.mjs",
    "build": "npm run generate:all && next build",
    "generate:llms-txt": "node scripts/generate-llms-txt.mjs",
    "start": "next start",
    "lint": "ultracite check",
    "fix": "ultracite fix",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "new:experiment": "plop experiment",
    "new:experiment:auto": "node scripts/create-experiment.mjs",
    "new:article": "plop article",
    "new:article:auto": "node scripts/create-article.mjs",
    "new:collected": "plop collected",
    "new:collected:auto": "node scripts/create-collected.mjs",
    "delete:experiment": "node scripts/delete-experiment.mjs",
    "delete:article": "node scripts/delete-article.mjs",
    "generate:posters": "node scripts/generate-posters.mjs",
    "generate:registry": "node scripts/generate-registry-json.mjs && node scripts/build-registry.mjs && node scripts/post-process-registry.mjs && node scripts/export-component-preview-slugs.mjs && node scripts/generate-registry-mdx.mjs",
    "capture": "node scripts/capture.mjs",
    "validate:experiments": "node scripts/validate-experiments.mjs",
    "validate:site-config": "node scripts/validate-site-config.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "optimize:videos": "node scripts/optimize-videos.mjs",
    "analyze": "next experimental-analyze",
    "analyze:output": "next experimental-analyze --output",
    "budget": "node scripts/bundle-size-budget.mjs",
    "smoke:tunnel": "node scripts/smoke-sentry-tunnel.mjs",
    "lighthouse": "npx lighthouse https://www.razisyed.cv --output=html --output-path=./.lighthouse-report.html --view",
    "prepare": "lefthook install",
    "postinstall": "node scripts/patch-r3f-perf.mjs"
  },
