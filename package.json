    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "not dead",
    "not ie 11"
  ],
  "author": "Razi Syed <syed.raziulhaque@gmail.com>",
  "keywords": [
    "experiments",
    "creative-coding",
    "shaders",
    "r3f",
    "gsap",
    "nextjs",
    "shadcn-registry"
