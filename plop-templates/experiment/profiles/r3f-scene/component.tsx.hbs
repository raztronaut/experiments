"use client";

{{#if includeToolkit}}
import { ExperimentCanvas } from "@/lib/toolkit/r3f";
{{else}}
import { Canvas } from "@react-three/fiber";
{{/if}}
import { useFrame } from "@react-three/fiber";
import { Environment, OrbitControls } from "@react-three/drei";
import { R3FDevToolsInjector } from "@/components/dev/R3FDevToolsInjector";
{{#if includeLeva}}
import { useDevControls } from "@/hooks/useDevControls";
{{/if}}
import type { Mesh } from "three";
import { useRef } from "react";

function Scene() {
  const meshRef = useRef<Mesh>(null);
{{#if includeLeva}}
  const { speed } = useDevControls("Rotation", { speed: { value: 0.5, min: 0, max: 3, step: 0.1 } });
{{/if}}

  useFrame((_, delta) => {
    if (meshRef.current) {
{{#if includeLeva}}
      meshRef.current.rotation.x += delta * speed * 0.6;
      meshRef.current.rotation.y += delta * speed;
{{else}}
      meshRef.current.rotation.x += delta * 0.3;
      meshRef.current.rotation.y += delta * 0.5;
{{/if}}
    }
  });

  return (
    <>
      <ambientLight intensity={0.4} />
      <directionalLight intensity={1} position={[10, 10, 5]} />
      <mesh castShadow ref={meshRef}>
        <boxGeometry args={[1.5, 1.5, 1.5]} />
        <meshStandardMaterial color="#ff6600" metalness={0.2} roughness={0.3} />
      </mesh>
      <mesh position={[0, -1.2, 0]} receiveShadow rotation={[-Math.PI / 2, 0, 0]}>
        <planeGeometry args={[10, 10]} />
        <meshStandardMaterial color="#1a1a1a" />
      </mesh>
      <Environment preset="city" />
      <OrbitControls enableDamping />
    </>
  );
}

export default function {{pascalCase name}}() {
  return (
{{#if includeToolkit}}
    <ExperimentCanvas
      camera=\{{ position: [0, 1, 4], fov: 50 }}
      shadows
    >
{{else}}
    <Canvas
      camera=\{{ position: [0, 1, 4], fov: 50 }}
      dpr={[1, 2]}
      shadows
    >
{{/if}}
      <R3FDevToolsInjector />
      <Scene />
{{#if includeToolkit}}
    </ExperimentCanvas>
{{else}}
    </Canvas>
{{/if}}
  );
}
