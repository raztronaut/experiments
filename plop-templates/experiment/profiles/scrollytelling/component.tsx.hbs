"use client";

import { useGSAP } from "@gsap/react";
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";
{{#if includeToolkit}}
import { createUnifiedScroll } from "@/lib/toolkit/scroll";
import type { UnifiedScrollHandle } from "@/lib/toolkit/scroll";
{{else}}
import Lenis from "lenis";
import Tempus from "tempus";
{{/if}}
{{#if includeLeva}}
import { useDevControls } from "@/hooks/useDevControls";
{{/if}}
import { useEffect, useRef } from "react";

gsap.registerPlugin(ScrollTrigger);

const sections = [
  { title: "Section One", subtitle: "Scroll to explore", bg: "#0a0a0a", color: "#ffffff" },
  { title: "Section Two", subtitle: "Pinned with GSAP ScrollTrigger", bg: "#1a1a2e", color: "#e2e8f0" },
  { title: "Section Three", subtitle: "Smooth scroll via Lenis", bg: "#16213e", color: "#cbd5e1" },
];

export default function {{pascalCase name}}() {
  const containerRef = useRef<HTMLDivElement>(null);
{{#if includeToolkit}}
  const scrollRef = useRef<UnifiedScrollHandle | null>(null);

  useEffect(() => {
    scrollRef.current = createUnifiedScroll();
    ScrollTrigger.refresh();
    return () => scrollRef.current?.destroy();
  }, []);
{{else}}
  const lenisRef = useRef<Lenis | null>(null);

  useEffect(() => {
    const lenis = new Lenis({ autoRaf: false });
    lenisRef.current = lenis;
    lenis.on("scroll", ScrollTrigger.update);

    const lenisDispose = Tempus.add((time: number) => lenis.raf(time), { priority: -1 });
    gsap.ticker.remove(gsap.updateRoot);
    const gsapDispose = Tempus.add((time: number) => gsap.updateRoot(time / 1000), { priority: 0 });
    gsap.ticker.lagSmoothing(0);

    ScrollTrigger.refresh();

    return () => {
      lenisDispose();
      gsapDispose();
      gsap.ticker.add(gsap.updateRoot);
      lenis.destroy();
    };
  }, []);
{{/if}}
{{#if includeLeva}}
  const { scrub } = useDevControls("Scroll", { scrub: { value: 1, min: 0, max: 3, step: 0.1 } });
{{/if}}

  useGSAP(() => {
    if (!containerRef.current) return;
    const panels = containerRef.current.querySelectorAll<HTMLElement>(".panel");

    panels.forEach((panel) => {
      const content = panel.querySelector(".panel-content");
      if (!content) return;

      gsap.fromTo(content,
        { opacity: 0, y: 60 },
        {
          opacity: 1,
          y: 0,
          duration: 1,
          ease: "power2.out",
          scrollTrigger: {
            trigger: panel,
            start: "top 80%",
            end: "top 20%",
{{#if includeLeva}}
            scrub: scrub,
{{else}}
            scrub: 1,
{{/if}}
          },
        }
      );
    });

    ScrollTrigger.create({
      trigger: panels[1],
      start: "top top",
      end: "+=50%",
      pin: true,
      pinSpacing: true,
    });
{{#if includeLeva}}
  }, { scope: containerRef, dependencies: [scrub] });
{{else}}
  }, { scope: containerRef });
{{/if}}

{{#if includeToolkit}}
  return (
    <div ref={containerRef}>
      {sections.map((section, i) => (
        <section
          key={i}
          className="panel flex min-h-screen items-center justify-center"
          style=\{{ backgroundColor: section.bg, color: section.color }}
        >
          <div className="panel-content px-8 text-center opacity-0">
            <h2 className="mb-4 font-bold text-5xl md:text-7xl">{section.title}</h2>
            <p className="text-xl opacity-70 md:text-2xl">{section.subtitle}</p>
          </div>
        </section>
      ))}
    </div>
  );
{{else}}
  return (
    <div ref={containerRef}>
      {sections.map((section, i) => (
        <section
          key={i}
          className="panel flex min-h-screen items-center justify-center"
          style=\{{ backgroundColor: section.bg, color: section.color }}
        >
          <div className="panel-content px-8 text-center opacity-0">
            <h2 className="mb-4 font-bold text-5xl md:text-7xl">{section.title}</h2>
            <p className="text-xl opacity-70 md:text-2xl">{section.subtitle}</p>
          </div>
        </section>
      ))}
    </div>
  );
{{/if}}
}
