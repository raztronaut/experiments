"use client";

{{#if includeToolkit}}
import { ExperimentCanvas } from "@/lib/toolkit/r3f";
{{else}}
import { Canvas } from "@react-three/fiber";
{{/if}}
import { useFrame, useThree } from "@react-three/fiber";
import { R3FDevToolsInjector } from "@/components/dev/R3FDevToolsInjector";
{{#if includeLeva}}
import { useDevControls } from "@/hooks/useDevControls";
{{/if}}
import { useMemo, useRef } from "react";
import { ShaderMaterial } from "three";

const vertexShader = /* glsl */ `
  varying vec2 vUv;
  void main() {
    vUv = uv;
    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
  }
`;

const fragmentShader = /* glsl */ `
  uniform float uTime;
  uniform vec2 uResolution;
  varying vec2 vUv;

  void main() {
    vec2 uv = vUv;
    vec3 col = 0.5 + 0.5 * cos(uTime + uv.xyx * 3.0 + vec3(0.0, 2.0, 4.0));
    col *= 0.8 + 0.2 * sin(uv.x * 10.0 + uTime * 0.5);
    gl_FragColor = vec4(col, 1.0);
  }
`;

function ShaderQuad() {
  const materialRef = useRef<ShaderMaterial>(null);
  const { viewport } = useThree();
{{#if includeLeva}}
  const { timeScale } = useDevControls("Shader", { timeScale: { value: 1, min: 0, max: 5, step: 0.1 } });
{{/if}}

  const uniforms = useMemo(() => ({
    uTime: { value: 0 },
    uResolution: { value: [viewport.width, viewport.height] },
  }), [viewport.width, viewport.height]);

  useFrame((state) => {
    if (materialRef.current) {
{{#if includeLeva}}
      materialRef.current.uniforms.uTime.value = state.clock.elapsedTime * timeScale;
{{else}}
      materialRef.current.uniforms.uTime.value = state.clock.elapsedTime;
{{/if}}
    }
  });

  return (
    <mesh>
      <planeGeometry args={[viewport.width, viewport.height]} />
      <shaderMaterial
        fragmentShader={fragmentShader}
        ref={materialRef}
        uniforms={uniforms}
        vertexShader={vertexShader}
        depthWrite={false}
        depthTest={false}
      />
    </mesh>
  );
}

export default function {{pascalCase name}}() {
  return (
{{#if includeToolkit}}
    <ExperimentCanvas
      camera=\{{ position: [0, 0, 1], fov: 75 }}
      tempus
    >
{{else}}
    <Canvas
      camera=\{{ position: [0, 0, 1], fov: 75 }}
      dpr={[1, 2]}
    >
{{/if}}
      <R3FDevToolsInjector />
      <ShaderQuad />
{{#if includeToolkit}}
    </ExperimentCanvas>
{{else}}
    </Canvas>
{{/if}}
  );
}
