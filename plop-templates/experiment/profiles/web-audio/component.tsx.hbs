"use client";

import { useCallback, useRef, useState } from "react";
{{#if includeLeva}}
import { useDevControls } from "@/hooks/useDevControls";
{{/if}}

function playTone(ctx: AudioContext, frequency: number, volume: number) {
  const osc = ctx.createOscillator();
  const gain = ctx.createGain();

  osc.type = "sine";
  osc.frequency.setValueAtTime(frequency, ctx.currentTime);

  gain.gain.setValueAtTime(0, ctx.currentTime);
  gain.gain.linearRampToValueAtTime(volume, ctx.currentTime + 0.02);
  gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.8);

  osc.connect(gain);
  gain.connect(ctx.destination);

  osc.start(ctx.currentTime);
  osc.stop(ctx.currentTime + 0.8);
}

const notes = [
  { label: "C", freq: 261.63 },
  { label: "D", freq: 293.66 },
  { label: "E", freq: 329.63 },
  { label: "F", freq: 349.23 },
  { label: "G", freq: 392.0 },
  { label: "A", freq: 440.0 },
  { label: "B", freq: 493.88 },
];

export default function {{pascalCase name}}() {
  const ctxRef = useRef<AudioContext | null>(null);
  const [activeNote, setActiveNote] = useState<string | null>(null);
{{#if includeLeva}}
  const { volume } = useDevControls("Audio", {
    volume: { value: 0.3, min: 0, max: 1, step: 0.05 },
  });
{{/if}}

  const play = useCallback((label: string, freq: number) => {
    if (!ctxRef.current) {
      ctxRef.current = new AudioContext();
    }
{{#if includeLeva}}
    playTone(ctxRef.current, freq, volume);
{{else}}
    playTone(ctxRef.current, freq, 0.3);
{{/if}}
    setActiveNote(label);
    setTimeout(() => setActiveNote(null), 200);
{{#if includeLeva}}
  }, [volume]);
{{else}}
  }, []);
{{/if}}

  return (
    <div className="flex flex-col items-center gap-8">
      <h1 className="font-bold text-3xl text-white">{{titleCase name}}</h1>
      <p className="max-w-md text-center text-neutral-400">
        Click a key to play a synthesized tone using the Web Audio API.
      </p>
      <div className="flex gap-2">
        {notes.map(({ label, freq }) => (
          <button
            key={label}
            onClick={() => play(label, freq)}
            className="h-40 w-14 rounded-lg border border-neutral-700 font-mono text-lg text-white transition-all duration-100"
            style=\{{
              background: activeNote === label
                ? "linear-gradient(to bottom, #667eea, #764ba2)"
                : "linear-gradient(to bottom, #1a1a2e, #0f0f1a)",
              transform: activeNote === label ? "scaleY(0.97)" : "scaleY(1)",
              transformOrigin: "top",
            }}
          >
            {label}
          </button>
        ))}
      </div>
    </div>
  );
}
